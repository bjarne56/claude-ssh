#!/usr/bin/env bash
# sshops — ssh-ops 业务 CLI dispatcher.
#
# 主路径走 Rust binary (rust/target/release/sshops-rs), bash 不再做业务实现.
# 旧 lib/*.sh + cmd_* bash fallback 已移除 (Rust 已完整覆盖, 见 git history
# commit e889077 之前). 现仅保留 setup/version/help 仍走 bash, 其他全透传.
#
# 主机选择器三入口 (优先级: 命令行从左到右):
#   1. @<相对路径>     SecureCRT session 精确匹配 (@aws/edge → Sessions/aws/edge.ini)
#   2. <关键词>        SecureCRT 模糊匹配 (文件名 / Hostname 子串, 唯一命中才接受)
#   3. --host H --user U [--port P] [--key K | --password P | --ask-password]
#                      临时参数, 完全绕过 SecureCRT
#
# 当用户给的是 @path 或 keyword, user/port/key 都从 SecureCRT 自动取
# (含 SSH2.ini 全局 Identity 回退).

set -euo pipefail

# === 定位 SSHOPS_HOME ===
_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
export SSHOPS_HOME="${SSHOPS_HOME:-$(cd "$_BIN_DIR/.." && pwd -P)}"
unset _BIN_DIR

usage() {
    cat <<'EOF'
sshops — SSH 远程运维 skill

用法:
  sshops run    <selector> "<cmd>"                跑命令并切片输出
  sshops open   <selector>                        仅 spawn pane,不跑命令
  sshops close  <selector>                        关 pane
  sshops peek   <selector>                        抓取 pane 当前可见文本
  sshops send   <selector> "<keys>" [--raw]       发原始按键 (不等 prompt),
                                                  驱动远端交互式菜单
                                                  例: sshops send H "1\r"
  sshops list-panes                               列当前项目所有 pane
  sshops recent <selector> [--seconds N]          最近 N 秒 human 活动
  sshops daemon-status                            查 daemon 状态
  sshops daemon-stop                              优雅停 daemon
  sshops setup                                    交互式初始化配置
  sshops version
  sshops help

<selector> 三种形式:
  @<相对路径>          SecureCRT session 精确, 如 @aws/edge
  <关键词>             SecureCRT 模糊匹配 (文件名 / Hostname)
  --host H --user U [--port P] [--key K | --password P | --ask-password]
                       临时参数 (绕过 SecureCRT)

可选参数:
  --port P            端口 (默认 22)
  --key PATH          私钥路径
  --password STR      明文密码 (sshpass 喂入)
  --ask-password      在终端 prompt 一次密码
  --prod              标记目标为生产机, 触发危险命令拦截
  --i-mean-it         强制放行危险命令 (Claude 不会主动加, 必须用户对话明确)
  --timeout SEC       命令执行超时秒数, 默认 30
  --no-daemon         强制 in-process 模式 (跳过 daemon, 用于调试)

输出: sshops run 输出 JSON
  {exit, duration_ms, output, session_id, cast_offset, selector,
   blocked, dangerous, recent_human_activity}
EOF
}

# === Rust 主路径: 业务子命令一律透传 ===
_SSHOPS_RUST="$SSHOPS_HOME/rust/target/release/sshops-rs"

# 主入口: 业务子命令必须走 Rust, 缺则报清晰错误
case "${1:-help}" in
    run|open|close|peek|send|list-panes|recent|daemon-status|daemon-stop)
        if [[ ! -x "$_SSHOPS_RUST" ]]; then
            printf '\033[31m✗\033[0m Rust binary 不存在: %s\n' "$_SSHOPS_RUST" >&2
            printf '  跑: cd %s/rust && cargo build --release\n' "$SSHOPS_HOME" >&2
            printf '  或: bash %s/install.sh (会自动构建)\n' "$SSHOPS_HOME" >&2
            exit 1
        fi
        exec "$_SSHOPS_RUST" "$@"
        ;;
    setup)
        exec "$SSHOPS_HOME/bin/sshops-setup" "${@:2}"
        ;;
    version|-v|--version)
        echo "ssh-ops 0.2.0"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        printf '\033[31m✗\033[0m 未知子命令: %s\n' "$1" >&2
        usage >&2
        exit 64
        ;;
esac
